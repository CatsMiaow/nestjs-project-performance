{
  "name": "nestjs-project-performance",
  "version": "0.0.0",
  "description": "Node.js framework NestJS project for performance",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.16.0",
  "scripts": {
    "lint": "oxlint && oxfmt --check \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "lint:fix": "oxlint --fix && pnpm format",
    "format": "oxfmt \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "build": "nest build",
    "start": "node dist/app",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "vitest run --exclude **/e2e/**/*.ts",
    "test:e2e": "vitest run --config ./test/vitest.e2e.ts",
    "esm": "node --import @swc-node/register/esm-register",
    "entity:load": "pnpm esm ./bin/entities.ts",
    "entity:sync": "pnpm esm ./bin/synchronize.ts",
    "doc:api": "nest build && node dist/swagger"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/passport": "^4.0.4",
    "@fastify/session": "^11.1.5",
    "@fastify/static": "^10.1.7",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/mysql": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.7",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/entity-generator": "^7.2.5",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  }
}
